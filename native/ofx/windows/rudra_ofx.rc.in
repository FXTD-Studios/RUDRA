// RUDRA.ofx's version, filled in by CMake (ofx/CMakeLists.txt). The same product name and version as
// RUDRA.exe and rudra-native.exe: SignPath signs a file only when they are the release's.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @RUDRA_RC_FILEFLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FXTD Studios"
            VALUE "FileDescription", "RUDRA OFX plug-in for Resolve and Nuke"
            VALUE "FileVersion", "@RUDRA_VERSION_LABEL@"
            VALUE "InternalName", "RUDRA"
            VALUE "LegalCopyright", "Copyright 2026 FXTD Studios. Apache License 2.0."
            VALUE "OriginalFilename", "RUDRA.ofx"
            VALUE "ProductName", "RUDRA"
            VALUE "ProductVersion", "@RUDRA_VERSION_LABEL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
