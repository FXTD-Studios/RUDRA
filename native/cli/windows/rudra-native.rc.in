// rudra-native.exe's version, filled in by CMake (cli/CMakeLists.txt). The same product name
// and version as RUDRA.exe (app/windows/rudra.rc.in): the signing checks both.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @RUDRA_RC_FILEFLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FXTD Studios"
            VALUE "FileDescription", "RUDRA engine and command line"
            VALUE "FileVersion", "@RUDRA_VERSION_LABEL@"
            VALUE "InternalName", "rudra-native"
            VALUE "LegalCopyright", "Copyright 2026 FXTD Studios. Apache License 2.0."
            VALUE "OriginalFilename", "rudra-native.exe"
            VALUE "ProductName", "RUDRA"
            VALUE "ProductVersion", "@RUDRA_VERSION_LABEL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
